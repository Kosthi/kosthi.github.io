---
import { LOCALES, type Lang } from "../i18n";

export interface Props {
	date: Date;
	lang: Lang;
}

const { date, lang } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(LOCALES[lang].dateLocale, {
			year: "numeric",
			month: lang === "zh" ? "numeric" : "short",
			day: "numeric",
		})
	}
</time>
