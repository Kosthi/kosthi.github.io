---
import Container from "./Container.astro";
import { AUTHOR, ICP_RECORD, PSB_RECORD, SITE_SINCE } from "../consts";
import { UI, type Lang } from "../i18n";

export interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];

const year = new Date().getFullYear();
const years = year > SITE_SINCE ? `${SITE_SINCE}–${year}` : `${SITE_SINCE}`;
---

<footer>
	<Container>
		<div class="footer-inner">
			<div class="footer-meta">
				<div>&copy; {years} <span aria-hidden="true">|</span> {AUTHOR.name}</div>
				<div class="records">
					<a href={ICP_RECORD.href} rel="noreferrer" target="_blank">{ICP_RECORD.number}</a>
					<a href={PSB_RECORD.href} rel="noreferrer" target="_blank">
						<img src={PSB_RECORD.icon} alt="" width="16" height="16" />
						{PSB_RECORD.number}
					</a>
				</div>
			</div>
			<div class="footer-actions">
				<button
					class="theme-button"
					data-theme-choice="light"
					aria-label="Use light theme"
					title="Light"
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="12" cy="12" r="4"></circle>
						<path
							d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"
						></path>
					</svg>
				</button>
				<button
					class="theme-button"
					data-theme-choice="dark"
					aria-label="Use dark theme"
					title="Dark"
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path>
					</svg>
				</button>
				<button
					class="theme-button"
					data-theme-choice="system"
					aria-label="Use system theme"
					title="System"
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<rect x="3" y="4" width="18" height="13" rx="2"></rect>
						<path d="M8 21h8M12 17v4"></path>
					</svg>
				</button>
				<button class="theme-button" id="back-to-top" aria-label={t.backToTop} title={t.backToTop}>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="m18 15-6-6-6 6"></path>
					</svg>
				</button>
			</div>
		</div>
	</Container>
</footer>

<script is:inline>
	(() => {
		const applyTheme = (preference) => {
			const dark =
				preference === "dark" ||
				(preference === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
			document.documentElement.classList.toggle("dark", dark);
			// Resolved value, not the preference -- Twikoo reads this attribute.
			document.documentElement.dataset.theme = dark ? "dark" : "light";
			document.querySelectorAll("[data-theme-choice]").forEach((button) => {
				button.setAttribute(
					"aria-pressed",
					String(button.dataset.themeChoice === preference),
				);
			});
			// Let embedded widgets (Twikoo) follow along.
			document.dispatchEvent(new CustomEvent("themechange", { detail: { dark } }));
		};

		document.querySelectorAll("[data-theme-choice]").forEach((button) => {
			button.addEventListener("click", () => {
				const preference = button.dataset.themeChoice;
				localStorage.setItem("theme", preference);
				applyTheme(preference);
			});
		});

		window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
			if ((localStorage.getItem("theme") || "system") === "system") {
				applyTheme("system");
			}
		});

		applyTheme(localStorage.getItem("theme") || "system");

		document.getElementById("back-to-top")?.addEventListener("click", () => {
			window.scrollTo({ top: 0, behavior: "smooth" });
		});
	})();
</script>

<style>
	footer {
		padding: 1.25rem 0 2rem;
		font-size: 0.875rem;
	}
	.footer-inner {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}
	.footer-meta {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		color: var(--text-muted);
	}
	.records {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.8125rem;
	}
	.records a {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		color: var(--text-muted);
		text-decoration: none;
	}
	.records a:hover {
		color: var(--text-strong);
		text-decoration: underline;
	}
	.records img {
		vertical-align: middle;
	}
	.footer-actions {
		display: flex;
		align-items: center;
		gap: 0.2rem;
	}
	.theme-button {
		display: grid;
		width: 2rem;
		height: 2rem;
		padding: 0;
		place-items: center;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--text);
		cursor: pointer;
		transition: color 180ms ease, background-color 180ms ease;
	}
	.theme-button:hover,
	.theme-button:focus-visible {
		background: var(--surface-hover);
		color: var(--text-strong);
	}
	.theme-button[aria-pressed="true"] {
		background: var(--surface-hover);
		color: var(--text-strong);
	}
	.theme-button svg {
		width: 1.15rem;
		height: 1.15rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.5;
	}
	@media (max-width: 480px) {
		.footer-inner {
			flex-direction: column;
		}
	}
</style>
