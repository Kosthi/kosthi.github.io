---
import BaseHead from "../components/BaseHead.astro";
import Container from "../components/Container.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { LOCALES, type Lang } from "../i18n";

export interface Props {
	title: string;
	description: string;
	lang: Lang;
	image?: string;
	enable_katex?: boolean;
	availableLangs?: Lang[];
}

const { lang, availableLangs, ...head } = Astro.props;
---

<!doctype html>
<html lang={LOCALES[lang].htmlLang}>
	<head>
		<BaseHead lang={lang} availableLangs={availableLangs} {...head} />
	</head>
	<body>
		<Header lang={lang} availableLangs={availableLangs} />
		<main>
			<Container>
				<slot />
			</Container>
		</main>
		<Footer lang={lang} />
	</body>
</html>
